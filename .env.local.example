# BeachCast / SurfCast monetization env vars.
# Copy this to .env.local and fill in the values you have.
# All vars are optional — the app degrades gracefully.

# Stripe Payment Link for the Pro tier.
# Create one via `STRIPE_SECRET_KEY=sk_test_... node scripts/create-stripe-link.mjs`
# Once set, /pricing shows a live "Get Pro" button.
NEXT_PUBLIC_STRIPE_PRO_LINK=

# Resend (https://resend.com) — for waitlist signup notifications.
# Without it, signups are still saved to data/waitlist.json on the server.
RESEND_API_KEY=
NOTIFY_EMAIL=fogliaevan@gmail.com
